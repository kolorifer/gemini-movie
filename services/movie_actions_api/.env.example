# Copy to ~/apps/movie-actions-api/.env and lock down with: chmod 600 .env
# Bind strictly to loopback using an unassigned port from `app-ports free`
ACTIONS_HOST=127.0.0.1
ACTIONS_PORT=40721

# Public HTTPS origin for Telegram action button URLs (no trailing slash)
MOVIE_INTEL_PUBLIC_BASE_URL=https://example.invalid/movie-intel

# Shared loopback authentication secret (must match movie-intake-api & movie-triage-api)
INTERNAL_API_SECRET=replace-with-strong-random-internal-secret

# Radarr v3 API (preserve any provider URL prefix; no trailing slash)
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=replace-with-radarr-api-key

# Telegram Bot API and topic routing
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_TOPIC_ID=
TELEGRAM_ADD_GRAB_TOPIC_ID=
TELEGRAM_GRAB_ANYWAY_TOPIC_ID=

# Action policy & TTL
MOVIE_INTEL_ACTION_TTL_SECONDS=604800
MOVIE_INTEL_STANDALONE_SKIP_ENABLED=true
# Optional absolute path to chmod-600 JSON policy for quality-only Alternative Grab
# MOVIE_INTEL_ALTERNATIVE_GRAB_CONFIG=/home/<user>/.config/movie-intel/alternative-grab.json

# Owner-private state path (explicit overrides MUST be absolute paths)
# ACTIONS_DB_PATH=/home/<user>/.local/state/movie-intel/actions.db

# Local loopback upstream services
INTAKE_API_URL=http://127.0.0.1:40720
TRIAGE_API_URL=http://127.0.0.1:40716

# Keep false in production; true enables zero-mutation shadow isolation mode
SHADOW_REPLAY_ENABLED=false
