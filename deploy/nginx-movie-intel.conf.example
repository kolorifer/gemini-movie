# User Nginx proxy rules for movie-intake-api & movie-actions-api on Ultra.cc
# Replace <PORT_INTAKE> and <PORT_ACTIONS> with the loopback ports selected by
# deploy/deploy-suite-ultra.sh (from `app-ports free`).
#
# SECURITY INVARIANTS (docs/ARCHITECTURE.md §7.3):
# - Disable access logging on BOTH secret-bearing routes (/webhook/ and /action/).
# - Preserve prefix stripping so backend apps see /webhook/{secret} and /action/{token}.
# - Enforce 1m max webhook body size and timeout within autobrr's 30s webhook window.
# - NEVER proxy /internal/, /replay, /health, /evaluate, or /feedback publicly.

location ^~ /movie-intel/webhook/ {
    access_log off;
    client_max_body_size 1m;
    proxy_connect_timeout 5s;
    proxy_send_timeout 15s;
    proxy_read_timeout 25s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:<PORT_INTAKE>/webhook/;
}

location ^~ /movie-intel/action/ {
    access_log off;
    client_max_body_size 32k;
    proxy_connect_timeout 5s;
    proxy_send_timeout 15s;
    proxy_read_timeout 45s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:<PORT_ACTIONS>/action/;
}
